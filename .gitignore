# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data.
#
# Raw snapshots are ignored by default: the roster sources are current-state
# tables that can be re-fetched at any time, and committing a copy per run would
# bloat the repo for no gain.
#
# Three kinds are committed on purpose, because they are the evidence the
# timeline is built from and nothing guarantees they stay online:
#
# * Solo Raid rankings. Once a season rotates out, the game stops serving its
#   top-50; the snapshot taken during the season may be the only copy left.
# * Official notices (site and Naver lounge). Every release date and every
#   Solo Raid schedule traces back to one; a notice deleted upstream must not
#   take a unit's release date with it. Collection is incremental, so a run adds
#   only the notices that are new or were edited.
# * enikk's season metadata, the record of when each season was actually played.
data/raw/**
!data/raw/.gitkeep
!data/raw/enikk_soloraid/
!data/raw/enikk_soloraid/**
!data/raw/notices_official/
!data/raw/notices_official/**
!data/raw/notices_naver/
!data/raw/notices_naver/**
!data/raw/enikk_seasons/
!data/raw/enikk_seasons/**
data/interim/**
!data/interim/.gitkeep

# One row per unit slot of every ranked deck (~300k rows, ~27 MB), rebuilt from
# the committed ranking snapshots by `nikke build raids`. The metric tables
# derived from it are committed.
data/processed/raid_entries.csv
data/cache/

# Generated report artifacts (charts are regenerated by `nikke viz`)
reports/**
!reports/.gitkeep

# The tier site, built by `nikke web` (and in CI by the pages workflow)
_site/

.DS_Store
