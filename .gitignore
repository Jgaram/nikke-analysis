# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data.
#
# Raw snapshots are ignored by default: the roster sources and the patch-note
# feed can be re-fetched at any time, and committing them would bloat the repo
# for no gain.
#
# Solo Raid rankings are the exception, and it is not a small one. Once a season
# rotates out, the site stops serving its top-50 and no amount of re-running
# brings it back - the snapshot taken during the season is the only copy that
# will ever exist. Those are committed on purpose.
data/raw/**
!data/raw/.gitkeep
!data/raw/enikk_soloraid/
!data/raw/enikk_soloraid/**
data/interim/**
!data/interim/.gitkeep
data/cache/

# Generated report artifacts (charts are regenerated by `nikke viz`)
reports/**
!reports/.gitkeep

.DS_Store
